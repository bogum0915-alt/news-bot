# 복사해서 .env 로 저장하고 값 채우기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini 요약 (없으면 요약 없이 발송)
GEMINI_API_KEY=

# 텔레그램 릴레이 (src/relay.py) — 없으면 릴레이 skip
# API_ID/HASH 는 investment-research/.env 와 같은 값,
# SESSION 은 scripts/make_session.py 로 새로 생성 (세션 파일 복사 금지)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# 선택: 몇 분 이내 기사만 푸시할지 (기본 60)
# LOOKBACK_MIN=60
